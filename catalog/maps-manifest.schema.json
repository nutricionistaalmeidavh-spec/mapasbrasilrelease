{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artisys.dev/schemas/maps-manifest-v1.json",
  "title": "ArtiSys Brazil Offline Maps Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseVersion", "generatedAt", "source", "maps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseVersion": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"},
    "generatedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "license"],
      "properties": {
        "provider": {"const": "OpenStreetMap"},
        "license": {"const": "ODbL-1.0"}
      }
    },
    "maps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "available", "version", "asset", "size", "sha256", "minZoom", "maxZoom", "bounds", "sourceDate"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["national", "state", "federal-district"]},
          "available": {"type": "boolean"},
          "version": {"type": ["string", "null"]},
          "asset": {"type": ["string", "null"]},
          "size": {"type": ["integer", "null"]},
          "sha256": {"type": ["string", "null"]},
          "minZoom": {"type": "integer", "minimum": 0, "maximum": 22},
          "maxZoom": {"type": "integer", "minimum": 0, "maximum": 22},
          "bounds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "sourceDate": {"type": ["string", "null"]}
        }
      }
    }
  }
}
